{
  "crons": [
    {
      "path": "/api/daily-reminders",
      "schedule": "30 3 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/book-online",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/book-online/:path*",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/post/:path*",
      "destination": "/blog.html",
      "permanent": true
    }
  ]
}
