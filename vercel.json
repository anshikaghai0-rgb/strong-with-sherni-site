{
  "regions": [
    "bom1"
  ],
  "crons": [
    {
      "path": "/api/daily-reminders",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/challenge-reminders?slot=morning",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/challenge-reminders?slot=afternoon",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/challenge-reminders?slot=evening",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/challenge-reminders?slot=standings",
      "schedule": "30 16 * * *"
    },
    {
      "path": "/api/challenge-reminders?slot=wake",
      "schedule": "30 23 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/book-online",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/book-online/:path*",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/post/:path*",
      "destination": "/blog.html",
      "permanent": true
    }
  ]
}